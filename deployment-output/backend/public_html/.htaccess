<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve bearer credentials for Laravel/Sanctum.
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Optional HTTPS enforcement: enable only after the SSL certificate is active.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Never expose hidden files, environment files, dependency manifests, or source metadata.
    RewriteRule (^|/)(\.|\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan)(/|$) - [F,L,NC]

    # Remove directory listings and route all non-files/non-directories through Laravel.
    Options -Indexes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<FilesMatch "^(\.|\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan)">
    Require all denied
</FilesMatch>
